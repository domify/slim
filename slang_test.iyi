module slang_test

# The Crystal shard's spec/slang_spec.cr (toddsundsted/slang 2.0.3), with
# its templates under spec/. `Process.pid` is a local `pid` there,
# as iyi has none. Left out: begin/rescue, as iyi has no exceptions, and
# Kemal's content_for. The templates after crystal.slang test what the port adds and fixes.

import slang::{Slang}

class Form
  def text_input(name)
    "<input type=\"text\" name=\"#{name.to_s}\" \\>"
  end
end

def form_for
  form = Form.new
  String.build do |io|
    io << "<form>"
    io << yield form
    io << "</form>"
  end
end

def p(value)
  value
end

def evaluates_to_true
  1 == 1
end

def evaluates_to_false
  1 == 2
end

def evaluates_to_hello
  "hello"
end

