same = "<div><span>this guy is nested</span><span>deeply nested</span><span>true is just true man</span></div>"
wrapped = "<div hello=\"world\" foo=\"bar\"></div>"
links = "<ul><li class=\"first\"><a href=\"/a\">A link</a></li><li><a href=\"/b\">B link</a></li></ul>"
numbers = "<p>1</p><p>2</p><p>3</p>"
form = "<form><input type=\"text\" name=\"hello\" \\><input type=\"submit\"></form>"
cases = [
  {"independent retained rendering", local_tape, "<div><p>&lt;&amp;&gt;</p><p><b>raw</b></p></div>"},
  {"basic document", basic, "<!DOCTYPE html><html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"><title>This is a title</title><style>h1 {color: red;}\np {color: green;}</style><style>h2 {color: blue;}</style></head><body><!--Multi-line comment<span>this is wrapped in a comment</span>\n--><!--[if IE]><p>Dat browser is old.</p>\n<![endif]--><h1>This is a slim file</h1><h2>This is blue</h2><span id=\"some-id\" class=\"classname\"><div id=\"hello\" class=\"world world2\"><span><span data-some-var=\"hello world haha\" two-attr=\"fun\">and a hello</span><span><span class=\"deep_nested\"><p>text inside of <p></p>4242text nodeother text node </span></span></span><span class=\"alongside\" pid=\"4242\"><custom-tag id=\"with-id\" pid=\"4242\"><span>ah</span><span>oh</span></custom-tag></span></div></span><div id=\"amazing-div\" some-attr=\"hello\"></div><!--This is a visible comment--><script>var num1 = 8*4;</script><script>var num2 = 8*3;\nalert(\"8 * 3 + 8 * 4 = \" + (num1 + num2));</script></body></html>"},
  {"UTF-8 text", utf8, "<!DOCTYPE html><html><head><title>Привет, мир</title></head><body><p>Предложение</p></body></html>"},
  {"a dash after interpolation is text", edge_control, "<span>my-5</span>"},
  {"escaped control code", edge_control_escaped, "<span>my-5</span>"},
  {"output after interpolation", edge_output, "<code>x5</code>"},
  {"escaped output", edge_output_escaped, "<code>x=5</code>"},
  {"string attribute", attr_string, "<span attr=\"hello\"></span>"},
  {"string attribute with spaces", attr_string_spaces, "<span attr=\"hello world\"></span>"},
  {"dynamic class", attr_dynamic_class, "<span class=\"my-class\">Foo</span>"},
  {"call in attribute", attr_call, "<span class=\"foo\"></span>"},
  {"parentheses in attribute", attr_parentheses, "<span class=\"foo\"></span>"},
  {"attributes evaluated once", attr_once, "<span class=\"foo\" type=\"bar\"></span>"},
  {"joined classes", attr_join_class, "<span class=\"foo bar\"></span>"},
  {"classes joined with a splat", attr_join_splat, "<span class=\"foo bar\" id=\"baz\"></span>"},
  {"blank class", attr_blank_class, "<span class=\"quuz\"></span>"},
  {"escaped attribute", attr_escape(%{"Hello" & world}), "<span attr=\"&quot;Hello&quot; &amp; world\"></span>"},
  {"escaped escaped attribute", attr_escape(%{&quot;Hello&quot; & world}), "<span attr=\"&amp;quot;Hello&amp;quot; &amp; world\"></span>"},
  {"quotes in interpolated attribute", interpolation_attr, "<input name=\"cris\" value=\"hello\">"},
  {"= at the end of an attribute", attr_equals, "<h1 id=\"asdf=\">Hello</h1>"},
  {"splat attributes", attr_splat, "<span class=\"foo\" id=\"bar\"></span>"},
  {"output", output, "<div>hello</div>"},
  {"escaped output with =", output_escape, "<div>&lt;ah&gt;</div>"},
  {"raw output with !=", output_raw, "<div><ah></div>"},
  {"inline HTML", html_inline, "<div><ah></div>"},
  {"nested HTML", html_nested, "<div><ah></div>"},
  {"inline text", text_inline, "<ah>"},
  {"nested text", text_nested, "<ah>"},
  {"quotes in text", text_quotes, "<div>\"ah\"</div>"},
  {"nested text without indentation", nest_text, "<div class=\"one\"><div class=\"two\"><ah></div></div>"},
  {"nested comment without indentation", nest_comment, "<div class=\"one\"><div class=\"two\"><!--Comment--></div></div>"},
  {"nested elements without indentation", nest_elements, "<a><b><c><d></d></c></b></a>"},
  {"multiline text indentation", nest_multiline, "<a><b>A\nB\n  C</b></a>"},
  {"raw HTML", raw_html, "<table><tr><td>4242</td></tr></table>"},
  {"if elsif else", if_elsif_else, same},
  {"case in", case_in, "<div><span>\"int\" is 123</span></div>"},
  {"case when", case_when, same},
  {"double quotes", double_quotes, "<div><span>\"hello\"</span><span>\"hello\" world</span><span>\"hello\" \"world\"</span><span>\"hello world\"</span><span>\"hello world\"</span><span>\"hello world\"</span><span>&quot;hello world&quot;</span><span>&quot;hello world&quot;</span><span>&quot;hello world&quot;</span></div>"},
  {"svg attributes with colons", svg, "<div><svg width=\"256\" height=\"448\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><defs><path id=\"shape1\" d=\"M184 144q0 3.25-2.375\"></path><path id=\"shape2\" d=\"M184 144q0 3.25-2.375\"></path></defs></svg></div>"},
  {"javascript", script, "<script src=\"https://somecdn/vue.min.js\"></script><script>var num = 8*3;\nconsole.log(num);</script><script>var num = 8*4;</script><script>new Vue({\n  el: '#app',\n  template: `\n    <div>\n      something\n    </div>\n  `\n})</script>"},
  {"stylesheets", style, "<style>h1 {color:red;}\np {\n  color:blue;\n}</style><style>h2 {color:green;}</style>"},
  {"blocks", blocks, "#{numbers}<div>#{numbers}</div>"},
  {"a dash after a tag is text", inline_dash, "<table><tr><td>-</td><td>- 3</td></tr></table><li>- Coming soon</li>"},
  {"output with a block", form_helper, "#{form}<div>#{form}</div><div>#{form}</div>"},
  {"boolean attributes", boolean_attributes, "<input type=\"checkbox\" checked><input type=\"checkbox\"><input type=\"checkbox\" checked=\"checked\"><input type=\"checkbox\" checked><input type=\"checkbox\"><input type=\"checkbox\" checked=\"hello\">"},
  {"attribute wrappers", attribute_wrappers, "#{wrapped}#{wrapped}#{wrapped}<div hello=\"4242\"></div>#{wrapped}#{wrapped}"},
  {"inline tags", inline_tags, "#{links}#{links}"},
  {"leading and trailing whitespace", whitespace, "<div><span>1</span> <span>2</span> <span>3</span></div>"},
  {"multiline verbatim text", multiline, "Line one.\nLine two.\n  <img>Line three.\nLine four.\n  <br> <div></div>"},
  {"crystal: code", crystal, "<p class=\"aa bb cc\"></p>"},
  {"attributes after a wrapper", wrapper_then_attribute, "<a href=\"x\">Link</a><b title=\"y\">Bold</b>"},
  {"=< and => whitespace", output_whitespace, "<p>x yz </p>"},
  {"output without a space before =", output_no_space, "<p>&lt;b&gt;</p><p><b></p><p id=\"x\" class=\"lead\">&lt;b&gt;</p><a href=\"/x\">&lt;b&gt;</a><b>&lt;b&gt;</b> "},
  {"ris: code", ris_code, "<p class=\"aa bb\"></p>"},
  {"iyi: code", iyi_code, "<p class=\"aa bb\"></p>"},
  {"operators in attributes", attr_operators, "<li class=\"y\" data-x data-f>T</li>"},
]

failures = cases.reject { |test| test[1] == test[2] }
failures.each do |test|
  puts "FAIL: Slim #{test[0]}\n  expected #{test[2].inspect}\n       got #{test[1].inspect}"
end
if failures.empty?
  puts "PASS: Slim, #{cases.size} cases of the original's specs and the port's fixes"
else
  exit 1
end
