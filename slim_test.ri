module slim_test

# The Crystal shard's spec/slang_spec.cr (toddsundsted/slang 2.0.3), with
# its templates under spec/. `Process.pid` is a local `pid` there,
# as iyi has none. Left out: begin/rescue, as iyi has no exceptions, and
# Kemal's content_for. The templates after crystal.slim test what the port adds and fixes.

import slim::{Slim}

# Test default tape rendering and, with -Dslim_string, retained String output.
# Separate executions preserve the single evaluation of fixture side effects.
macro checked_render(filename)
  {% if flag?(:slim_string) %}
    ::Slim::Slim.render_string({{filename}})
  {% else %}
    begin
      %actual = ""
      Tape.scope do
        %actual = ::Slim::Slim.render({{filename}}, 1).to_s
      end
      %actual
    end
  {% end %}
end

class Form
  def text_input(name)
    "<input type=\"text\" name=\"#{name.to_s}\" \\>"
  end
end

def form_for(&)
  form = Form.new
  String.build do |io|
    io << "<form>"
    io << yield form
    io << "</form>"
  end
end

def p(value)
  value
end

def evaluates_to_true
  1 == 1
end

def evaluates_to_false
  1 == 2
end

def evaluates_to_hello
  "hello"
end

def local_tape : String
  result = ""
  Tape.scope do
    text = TapeString.build(1) { |writer| writer.append("<&>") }
    raw = TapeString.build(1) { |writer| writer.append("<b>raw</b>") }
    outer = IyiRegion.tape
    cursor = IyiHeap.read64(outer)
    20.times do
      result = Slim.render_string("spec/local-tape.slim", 1)
      raise "render_string changed caller's tape" unless IyiRegion.tape == outer
      raise "render_string retained temporary buffers" unless IyiHeap.read64(outer) == cursor
      raise "render_string damaged outer text" unless text.to_s == "<&>"
    end
  end
  result
end

