module streaming_test
import slim::{Slim}

# A consumer implementing only << must still work after direct escaping.
class Sink
  @text : String::Builder

  def initialize
    @text = String::Builder.new
  end

  def <<(text : String) : Sink
    @text << text
    self
  end

  def to_s : String
    @text.to_s
  end
end

class Counter
  getter calls : Int32
  getter events : String

  def initialize
    @calls = 0
    @events = ""
  end

  def reset : Nil
    @calls = 0
    @events = ""
  end

  def name : String
    @events += "class"
    "middle"
  end

  def attrs : Hash(String, String)
    @calls += 1
    @events += "splat"
    {"class" => "last & more", "title" => "x<y"}
  end
end

COUNTER = Counter.new

def first_class : String
  COUNTER.name
end

def next_attrs : Hash(String, String)
  COUNTER.attrs
end

def check(actual : String, expected : String) : Nil
  if actual != expected
    puts "FAIL: expected #{expected.inspect}, got #{actual.inspect}"
    exit 1
  end
end

text = "<&>\"' café Привет"
raw = "<b>raw</b>"
blank = "　 \t"
classes = "é & \"test\""
number = -9223372036854775807_i64 - 1_i64
expected = "<div><p title=\"&lt;&amp;&gt;&quot;&#39; café Привет\">&lt;&amp;&gt;&quot;&#39; café Привет</p><p><b>raw</b></p><span></span><span class=\"first é &amp; &quot;test&quot;\"></span><span>-9223372036854775808</span></div>"
check(Slim.render_string("spec/streaming.slim"), expected)
sink = Sink.new
Slim.embed("spec/streaming.slim", sink)
check(sink.to_s, expected)

def tape_page(expected : String) : Nil
  copy = ""
  tape do
    blank = "　 \t"
    classes = "é & \"test\""
    number = -9223372036854775807_i64 - 1_i64
    # Both escaped and raw tape model values must render without to_s first.
    text = Tape::String.build(1) { |writer| writer.append("<&>\"' café Привет") }
    raw = Tape::String.build(1) { |writer| writer.append("<b>raw</b>") }
    page = Slim.render("spec/streaming.slim", 0)
    copy = page.to_heap
    check(copy, expected)
  end
  check(copy, expected)
end

tape_page(expected)
puts "PASS: streaming escaping, UTF-8, blank classes, custom sink, tape model, zero-capacity growth and retained copy"

COUNTER.reset
check(Slim.render_string("spec/splat-once.slim"), "<span class=\"first middle last &amp; more\" title=\"x&lt;y\"></span>")
check(COUNTER.calls.to_s, "1")
check(COUNTER.events, "classsplat")
tape do
  COUNTER.reset
  check(Slim.render("spec/splat-once.slim").to_heap, "<span class=\"first middle last &amp; more\" title=\"x&lt;y\"></span>")
  check(COUNTER.calls.to_s, "1")
  check(COUNTER.events, "classsplat")
end

# Signed minimum, unsigned maximum, zero and raw numeric output keep their bytes.
values = [0_i64, -1_i64, 9223372036854775807_i64, -9223372036854775807_i64 - 1_i64]
tape do
  values.each do |value|
    buffer = Slim::TapeBuffer.new
    Slim.write_escaped(buffer, value)
    check(buffer.to_s, value.to_s)
  end
  buffer = Slim::TapeBuffer.new
  Slim.write_raw(buffer, 18446744073709551615_u64)
  check(buffer.to_s, "18446744073709551615")
end

check(Slim.escape(text), "&lt;&amp;&gt;&quot;&#39; café Привет")
check(Slim.escape("plain café"), "plain café")
check(Slim.escape(""), "")

# render_string opens a scope, returns owned bytes, and leaves no active
# tape behind. Inside a caller scope it must not release that caller's data.
check(Slim.render_string("spec/tape-first.slim"), "<p>true</p>")
raise "render left a tape active" unless IyiRegion.tape == 0_u64
retained = ""
tape do
  sentinel = Tape::String.build { |writer| writer.append("still alive") }
  retained = Slim.render_string("spec/tape-first.slim")
  check(sentinel.to_heap, "still alive")
  check(Slim.render("spec/tape-first.slim").to_heap, retained)
end
tape do
  overwrite = Slim::TapeBuffer.new
  overwrite << "overwrite released storage"
end
check(retained, "<p>true</p>")
raise "nested render left a tape active" unless IyiRegion.tape == 0_u64
puts "PASS: render uses tape, render_string copies retained output and preserves outer scopes"

tape do
  check(Slim.render("spec/tape-first.slim").to_heap, "<p>true</p>")
end
